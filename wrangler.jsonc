{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deadclock-com",
  "compatibility_date": "2026-07-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "deadclock.gg", "custom_domain": true }
  ]
}
